+/// Windows Server Data Deduplication leaves a `Dedup` directory under
+/// `System Volume Information` on deduplicated volumes.
+fn ntfs_dedup_marker_exists(target: &str) -> bool {
+    Path::new(target)
+        .join("System Volume Information")
+        .join("Dedup")
+        .is_dir()
+}
+
+fn mount_ntfs3g(source: &str, target: &str) -> Result<(), Error> {
+    let mut cmd = Command::new("/usr/bin/ntfs-3g");
+    cmd.args(["-o", "ro", source, target].iter());
+    run_command(cmd, None)?;
+    Ok(())
+}
