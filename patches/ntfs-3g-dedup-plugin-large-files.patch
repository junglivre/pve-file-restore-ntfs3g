+/*
+ *		Find the first stream map entry whose data ends beyond an offset
+ *
+ *	The entries are ordered by data end, so do a dichotomic search,
+ *	reading one entry at a time. A wrong order is caught later, when
+ *	checking that the offset is within the chunk found.
+ *
+ *	Returns the index of the entry, smap_cnt if there is none,
+ *		or -1 if an entry could not be read.
+ */
+
+static s32 dedup_find_smap(ntfs_attr *na_stream, u32 entries_offset,
+			u32 smap_cnt, u64 offset)
+{
+	struct DEDUP_SMAP_ENTRY smap_entry;
+	u32 lower;
+	u32 upper;
+	u32 middle;
+
+	lower = 0;
+	upper = smap_cnt;
+	while (lower < upper) {
+		middle = lower + ((upper - lower) >> 1);
+		if (!dedup_read_smaps(na_stream, entries_offset,
+					middle, 1, &smap_entry))
