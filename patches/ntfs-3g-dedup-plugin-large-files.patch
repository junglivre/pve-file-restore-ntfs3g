+static void sha512(const u8 *data, size_t len, u8 *digest)
+{
+	u64 h[8];
+	u8 last[256];
+	size_t done;
+	size_t rest;
+	size_t tail;
+	u64 bits;
+	int i;
+
+	memcpy(h, sha512_init, sizeof(h));
+	for (done=0; (len - done) >= 128; done += 128)
+		sha512_block(h, data + done);
+	rest = len - done;
+	tail = (rest < 112 ? 128 : 256);
+	memset(last, 0, sizeof(last));
+	memcpy(last, data + done, rest);
+	last[rest] = 0x80;
+		/* bit count, the high 64 bits are always zero here */
+	bits = (u64)len << 3;
+	for (i=0; i<8; i++)
+		last[tail - 1 - i] = (u8)(bits >> (8*i));
+	sha512_block(h, last);
+	if (tail == 256)
+		sha512_block(h, last + 128);
+	for (i=0; i<64; i++)
+		digest[i] = (u8)(h[i >> 3] >> (56 - 8*(i & 7)));
